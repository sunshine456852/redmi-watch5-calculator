<script>
  const calc = require('../../common/calc.js')

  // ---------- 顶层工具函数 ----------
  const OPSET = ['+', '-', '×', '÷', '^']
  const isOp = c => OPSET.indexOf(c) >= 0
  const isDigit = c => (c >= '0' && c <= '9')

  const FUNC_TOKENS = {
    'sin': 'sin(', 'cos': 'cos(', 'tan': 'tan(',
    'asin': 'asin(', 'acos': 'acos(', 'atan': 'atan(',
    'ln': 'ln(', 'log': 'log(', '√': '√(', 'A': 'A(', 'C': 'C('
  }
  const isFuncKey = k => !!FUNC_TOKENS[k]
  const FUNC_NAMES = ['asin', 'acos', 'atan', 'sin', 'cos', 'tan', 'ln', 'log']

  // 求值后：按下“开始新算式”的键则清空
  function isStartNew(key) {
    return isDigit(key) || key === '.' || key === 'π' || key === 'e' || isFuncKey(key) || key === '('
  }

  function openCount(s) { let n = 0; for (const c of s) if (c === '(') n++; return n }
  function closeCount(s) { let n = 0; for (const c of s) if (c === ')') n++; return n }

  // 退格：整体删除函数名
  function deleteLast(s) {
    if (!s) return ''
    for (const f of FUNC_NAMES) {
      if (s.endsWith(f)) return s.slice(0, -f.length)
    }
    return s.slice(0, -1)
  }

  export default {
    private: {
      mode: 'calc',            // calc | convert | solve
      angleMode: 'DEG',
      expr: '',
      exprView: '',
      result: '',
      error: '',
      justEvaluated: false,
      answer: null,
      kbPage: 0,

      // 单位换算
      cats: calc.UNIT_CATEGORIES,
      convCat: 0,
      convFrom: 0,
      convTo: 1,
      convFromVal: '',
      convToVal: '',
      convFromName: '米(m)',
      convToName: '千米(km)',
      convFocus: 'from',
      isConc: false,
      concRho: '',
      concM: '',

      // 方程求解
      eqActive: 'a',
      eqA: '', eqB: '', eqC: '',
      eqDelta: '',
      eqRootCount: 0,
      eqX1: '', eqX2: '', eqMsg: ''
    },

    onInit() {
      this.refreshConv()
    },

    // ---------- 模式 ----------
    setMode(m) {
      this.mode = m
      if (m === 'convert') this.refreshConv()
      if (m === 'solve') this.eqActive = 'a'
    },

    // ---------- 计算器 ----------
    toggleAngle() {
      this.angleMode = this.angleMode === 'DEG' ? 'RAD' : 'DEG'
      this.refreshPreview()
    },
    onKbChange(e) {
      this.kbPage = e.index
    },
    setExpr(s) {
      this.expr = s
      this.exprView = calc.pretty(s)
    },
    refreshPreview() {
      this.error = ''
      if (!this.expr || !this.expr.trim()) { this.result = ''; return }
      try {
        const v = calc.evaluate(this.expr, this.angleMode)
        this.result = calc.formatNumber(v)
      } catch (err) {
        this.result = ''
      }
    },
    press(key) {
      this.error = ''
      if (key === 'AC') {
        this.setExpr(''); this.result = ''; this.justEvaluated = false; this.answer = null
        return
      }
      if (key === 'Del') {
        this.justEvaluated = false
        this.setExpr(deleteLast(this.expr))
        this.refreshPreview()
        return
      }
      if (key === '=') { this.evaluateExpr(); return }
      if (key === 'fn') { this.kbPage = 1; return }
      if (key === '123') { this.kbPage = 0; return }
      this.append(key)
    },
    append(key) {
      if (this.justEvaluated) {
        if (isStartNew(key)) {
          this.setExpr(''); this.result = ''; this.answer = null
        } else {
          this.setExpr(calc.numToStr(this.answer)); this.result = ''
        }
        this.justEvaluated = false
      }
      const e = this.expr
      const last = e.slice(-1)

      // 数字 / 小数点
      if (isDigit(key) || key === '.') {
        if (key === '.' && last === '.') { this.refreshPreview(); return }
        if (last === 'π' || last === 'e' || last === ')' || last === '!') {
          this.setExpr(e + '×' + key)
        } else {
          this.setExpr(e + key)
        }
        this.refreshPreview(); return
      }
      // 运算符
      if (isOp(key)) {
        if (e === '') {
          if (key === '-') this.setExpr('-')
          this.refreshPreview(); return
        }
        if (isOp(last)) {
          if (key === '-' && last === '^') this.setExpr(e + key)
          else this.setExpr(e.slice(0, -1) + key)
          this.refreshPreview(); return
        }
        if (last === '(') {
          if (key === '-') this.setExpr(e + key)
          this.refreshPreview(); return
        }
        this.setExpr(e + key); this.refreshPreview(); return
      }
      // 左括号
      if (key === '(') {
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e' || last === '!') {
          this.setExpr(e + '×(')
        } else {
          this.setExpr(e + '(')
        }
        this.refreshPreview(); return
      }
      // 右括号
      if (key === ')') {
        if (openCount(e) <= closeCount(e) || isOp(last) || last === '(') { this.refreshPreview(); return }
        this.setExpr(e + ')'); this.refreshPreview(); return
      }
      // 逗号（排列 A / 组合 C 的参数分隔）
      if (key === ',') {
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e') {
          this.setExpr(e + ',')
        }
        this.refreshPreview(); return
      }
      // 常量 π / e
      if (key === 'π' || key === 'e') {
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e' || last === '!') {
          this.setExpr(e + '×' + key)
        } else {
          this.setExpr(e + key)
        }
        this.refreshPreview(); return
      }
      // 函数
      if (isFuncKey(key)) {
        const t = FUNC_TOKENS[key]
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e' || last === '!') {
          this.setExpr(e + '×' + t)
        } else {
          this.setExpr(e + t)
        }
        this.refreshPreview(); return
      }
      // 幂运算简写
      if (key === 'x^y') {
        if (e === '' || isOp(last) || last === '(') { this.refreshPreview(); return }
        this.setExpr(e + '^'); this.refreshPreview(); return
      }
      if (key === 'x²' || key === 'x³') {
        if (e === '' || isOp(last) || last === '(') { this.refreshPreview(); return }
        this.setExpr(e + (key === 'x²' ? '^2' : '^3')); this.refreshPreview(); return
      }
      if (key === 'e^x' || key === '10^x') {
        const t = key === 'e^x' ? 'e^' : '10^'
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e' || last === '!') {
          this.setExpr(e + '×' + t)
        } else {
          this.setExpr(e + t)
        }
        this.refreshPreview(); return
      }
      // 阶乘
      if (key === 'n!') {
        if ((isDigit(last) || last === ')' || last === 'π' || last === 'e') && last !== '!') {
          this.setExpr(e + '!')
        }
        this.refreshPreview(); return
      }
      // 百分比
      if (key === '%') {
        if (isDigit(last) || last === ')' || last === 'π' || last === 'e') {
          this.setExpr(e + '%')
        }
        this.refreshPreview(); return
      }
    },
    evaluateExpr() {
      if (!this.expr || !this.expr.trim()) return
      try {
        const v = calc.evaluate(this.expr, this.angleMode)
        this.answer = v
        this.result = calc.formatNumber(v)
        this.justEvaluated = true
        this.error = ''
      } catch (err) {
        this.result = ''
        this.error = (err && err.message) || '表达式错误'
        this.justEvaluated = false
      }
    },

    // ---------- 单位换算 ----------
    setCat(idx) {
      this.convCat = idx
      const cat = this.cats[idx]
      this.convFrom = 0
      this.convTo = Math.min(1, cat.units.length - 1)
      this.convFromVal = ''
      this.convToVal = ''
      this.convFocus = 'from'
      this.isConc = (cat.type === 'concentration')
      this.concRho = ''
      this.concM = ''
      this.refreshConv()
    },
    cycleFrom() {
      const cat = this.cats[this.convCat]
      this.convFrom = (this.convFrom + 1) % cat.units.length
      this.refreshConv()
    },
    cycleTo() {
      const cat = this.cats[this.convCat]
      this.convTo = (this.convTo + 1) % cat.units.length
      this.refreshConv()
    },
    focusConv(t) {
      this.convFocus = t
      if (t === 'from' || t === 'to') {
        this.convFromVal = ''
        this.convToVal = ''
      }
    },
    refreshConv() {
      const cat = this.cats[this.convCat]
      this.convFromName = cat.units[this.convFrom].name
      this.convToName = cat.units[this.convTo].name
      this.recomputeConv()
    },
    recomputeConv() {
      const cat = this.cats[this.convCat]
      const fromId = cat.units[this.convFrom].id
      const toId = cat.units[this.convTo].id
      const extra = { rho: parseFloat(this.concRho), M: parseFloat(this.concM) }
      try {
        if (this.convFocus === 'to') {
          const val = parseFloat(this.convToVal)
          if (isNaN(val)) { this.convFromVal = ''; return }
          this.convFromVal = calc.formatNumber(calc.convertUnit(val, toId, fromId, cat, extra))
        } else {
          const val = parseFloat(this.convFromVal)
          if (isNaN(val)) { this.convToVal = ''; return }
          this.convToVal = calc.formatNumber(calc.convertUnit(val, fromId, toId, cat, extra))
        }
      } catch (err) {
        if (this.convFocus === 'to') this.convFromVal = ''
        else this.convToVal = ''
      }
    },
    numInput(key, field) {
      let s = this[field]
      if (key === 'C') { this[field] = ''; return }
      if (key === 'Del') { this[field] = s.slice(0, -1); return }
      if (key === '±') {
        this[field] = s.startsWith('-') ? s.slice(1) : ('-' + s)
        return
      }
      if (key === '.') {
        if (s.indexOf('.') >= 0) return
        if (s === '' || s === '-') this[field] = (s === '-') ? '-0.' : '0.'
        else this[field] = s + '.'
        return
      }
      if (s === '0') this[field] = key
      else if (s === '-0') this[field] = '-' + key
      else this[field] = s + key
    },
    convKey(key) {
      if (this.convFocus === 'rho') { this.numInput(key, 'concRho'); this.recomputeConv(); return }
      if (this.convFocus === 'm') { this.numInput(key, 'concM'); this.recomputeConv(); return }
      if (this.convFocus === 'to') { this.numInput(key, 'convToVal'); this.recomputeConv(); return }
      this.numInput(key, 'convFromVal')
      this.recomputeConv()
    },

    // ---------- 方程求解 ----------
    setEq(k) { this.eqActive = k },
    eqKey(key) {
      if (this.eqActive === 'a') this.numInput(key, 'eqA')
      else if (this.eqActive === 'b') this.numInput(key, 'eqB')
      else this.numInput(key, 'eqC')
    },
    solveEq() {
      const a = parseFloat(this.eqA || '')
      const b = parseFloat(this.eqB || '')
      const c = parseFloat(this.eqC || '')
      this.eqDelta = ''
      this.eqRootCount = 0
      this.eqX1 = ''
      this.eqX2 = ''
      this.eqMsg = ''
      if (isNaN(a)) { this.eqMsg = '请填写系数 a'; return }
      try {
        const r = calc.solveQuadratic(a, isNaN(b) ? 0 : b, isNaN(c) ? 0 : c)
        this.eqDelta = calc.formatNumber(r.delta)
        if (r.roots.length === 0) {
          this.eqMsg = '无实数根'
        } else if (r.roots.length === 1) {
          this.eqRootCount = 1
          this.eqX1 = calc.formatNumber(r.roots[0])
        } else {
          this.eqRootCount = 2
          this.eqX1 = calc.formatNumber(r.roots[0])
          this.eqX2 = calc.formatNumber(r.roots[1])
        }
      } catch (err) {
        this.eqMsg = (err && err.message) || '求解失败'
      }
    },

    // ---------- 数字键盘统一入口 ----------
    numKey(key) {
      if (this.mode === 'convert') this.convKey(key)
      else if (this.mode === 'solve') this.eqKey(key)
    }
  }
</script>
