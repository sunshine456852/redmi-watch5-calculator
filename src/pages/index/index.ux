          <div class="key k-num" @click="numKey('3')"><text class="key-text">3</text></div>
          <div class="key k-op" @click="numKey('±')"><text class="key-text">±</text></div>
        </div>
        <div class="kb-row">
          <div class="key k-num key-wide3" @click="numKey('0')"><text class="key-text">0</text></div>
          <div class="key k-num" @click="numKey('.')"><text class="key-text">.</text></div>
        </div>
      </div>
    </div>

    <!-- ============ 方程求解模式 ============ -->
    <div class="solve-mode" if="{{mode === 'solve'}}">
      <div class="solve-body">
        <text class="eq-title">ax² + bx + c = 0</text>

        <div class="eq-row" @click="setEq('a')">
          <text class="eq-label">a =</text>
          <text class="eq-value {{eqActive === 'a' ? 'conv-active' : ''}}">{{eqA ? eqA : '?'}}</text>
        </div>
        <div class="eq-row" @click="setEq('b')">
          <text class="eq-label">b =</text>
