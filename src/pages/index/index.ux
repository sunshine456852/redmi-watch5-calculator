<template>
  <div class="page">

    <!-- ============ 顶部胶囊快捷栏 ============ -->
    <div class="capsule-bar">
      <div class="tab {{mode === 'calc' ? 'tab-on' : ''}}" @click="setMode('calc')">
        <text class="{{mode === 'calc' ? 'tab-label-on' : 'tab-label'}}">计算器</text>
      </div>
      <div class="tab {{mode === 'convert' ? 'tab-on' : ''}}" @click="setMode('convert')">
        <text class="{{mode === 'convert' ? 'tab-label-on' : 'tab-label'}}">单位换算</text>
      </div>
      <div class="tab {{mode === 'solve' ? 'tab-on' : ''}}" @click="setMode('solve')">
        <text class="{{mode === 'solve' ? 'tab-label-on' : 'tab-label'}}">方程求解</text>
      </div>
    </div>

    <!-- ============ 计算器模式 ============ -->
    <div class="calc-mode" if="{{mode === 'calc'}}">
      <!-- 显示区 -->
      <div class="display">
        <div class="display-top">
          <div class="deg-toggle {{angleMode === 'DEG' ? 'deg-on' : ''}}" @click="toggleAngle">
            <text class="{{angleMode === 'DEG' ? 'deg-label-on' : 'deg-label'}}">{{angleMode}}</text>
          </div>
          <text class="page-hint">{{kbPage === 0 ? '基础' : '函数'}}</text>
        </div>
        <div class="expr-wrap">
          <scroll class="expr-scroll" scroll-x="true">
            <text class="expr-text">{{exprView}}</text>
          </scroll>
        </div>
        <text class="result-text {{error ? 'result-err' : ''}}">{{error ? error : (result ? result : '0')}}</text>
      </div>

      <!-- 键盘区：水平 Swiper 两页 -->
      <swiper class="keyboard" index="{{kbPage}}" indicator="false" loop="false" @change="onKbChange">
        <!-- 第 1 页：基础键 -->
        <div class="kb-page">
          <div class="kb-row">
            <div class="key k-ac" @click="press('AC')"><text class="key-text">AC</text></div>
            <div class="key k-ac" @click="press('Del')"><text class="key-text">Del</text></div>
            <div class="key k-num" @click="press('(')"><text class="key-text">(</text></div>
            <div class="key k-num" @click="press(')')"><text class="key-text">)</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-num" @click="press('7')"><text class="key-text">7</text></div>
            <div class="key k-num" @click="press('8')"><text class="key-text">8</text></div>
            <div class="key k-num" @click="press('9')"><text class="key-text">9</text></div>
            <div class="key k-op" @click="press('÷')"><text class="key-text">÷</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-num" @click="press('4')"><text class="key-text">4</text></div>
            <div class="key k-num" @click="press('5')"><text class="key-text">5</text></div>
            <div class="key k-num" @click="press('6')"><text class="key-text">6</text></div>
            <div class="key k-op" @click="press('×')"><text class="key-text">×</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-num" @click="press('1')"><text class="key-text">1</text></div>
            <div class="key k-num" @click="press('2')"><text class="key-text">2</text></div>
            <div class="key k-num" @click="press('3')"><text class="key-text">3</text></div>
            <div class="key k-op" @click="press('-')"><text class="key-text">-</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-num" @click="press('0')"><text class="key-text">0</text></div>
            <div class="key k-num" @click="press('.')"><text class="key-text">.</text></div>
            <div class="key k-num" @click="press('%')"><text class="key-text">%</text></div>
            <div class="key k-op" @click="press('+')"><text class="key-text">+</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-sw" @click="press('fn')"><text class="key-text">函数</text></div>
            <div class="key k-eq key-wide" @click="press('=')"><text class="key-text">=</text></div>
          </div>
        </div>

        <!-- 第 2 页：科学函数 -->
        <div class="kb-page">
          <div class="kb-row">
            <div class="key k-ac" @click="press('AC')"><text class="key-text">AC</text></div>
            <div class="key k-ac" @click="press('Del')"><text class="key-text">Del</text></div>
            <div class="key k-sci" @click="press('x^y')"><text class="key-text">x^y</text></div>
            <div class="key k-sci" @click="press('√')"><text class="key-text">√</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-sci" @click="press('sin')"><text class="key-text">sin</text></div>
            <div class="key k-sci" @click="press('cos')"><text class="key-text">cos</text></div>
            <div class="key k-sci" @click="press('tan')"><text class="key-text">tan</text></div>
            <div class="key k-num" @click="press('π')"><text class="key-text">π</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-sci" @click="press('asin')"><text class="key-text">asin</text></div>
            <div class="key k-sci" @click="press('acos')"><text class="key-text">acos</text></div>
            <div class="key k-sci" @click="press('atan')"><text class="key-text">atan</text></div>
            <div class="key k-num" @click="press('e')"><text class="key-text">e</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-sci" @click="press('ln')"><text class="key-text">ln</text></div>
            <div class="key k-sci" @click="press('log')"><text class="key-text">log</text></div>
            <div class="key k-sci" @click="press('x²')"><text class="key-text">x²</text></div>
            <div class="key k-sci" @click="press('x³')"><text class="key-text">x³</text></div>
          </div>
          <div class="kb-row">
            <div class="key k-sci" @click="press('e^x')"><text class="key-text">e^x</text></div>
