          <text class="eq-value {{eqActive === 'c' ? 'conv-active' : ''}}">{{eqC ? eqC : '?'}}</text>
        </div>

        <div class="solve-btn" @click="solveEq"><text class="solve-label">求 解</text></div>

        <div class="eq-result">
          <text class="eq-delta" if="{{eqDelta !== ''}}">Δ = {{eqDelta}}</text>
          <text class="eq-root" if="{{eqRootCount === 2}}">x₁ = {{eqX1}}  x₂ = {{eqX2}}</text>
          <text class="eq-root" if="{{eqRootCount === 1}}">x = {{eqX1}}</text>
          <text class="eq-root result-err" if="{{eqMsg !== ''}}">{{eqMsg}}</text>
        </div>
      </div>

      <div class="numpad">
        <div class="kb-row">
          <div class="key k-num" @click="numKey('7')"><text class="key-text">7</text></div>
          <div class="key k-num" @click="numKey('8')"><text class="key-text">8</text></div>
